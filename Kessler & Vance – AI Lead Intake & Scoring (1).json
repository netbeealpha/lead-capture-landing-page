      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "jpzGrzRtyqWMXjyR",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Normalize Lead Fields').item.json;\nconst aiRaw = $input.item.json.choices[0].message.content;\nlet parsed;\ntry {\n  parsed = JSON.parse(aiRaw);\n} catch (e) {\n  parsed = { score: 'warm', summary: 'Could not parse AI response.', suggestedAction: 'Review manually.' };\n}\n\nreturn {\n  json: {\n    ...lead,\n    score: parsed.score,\n    summary: parsed.summary,\n    suggestedAction: parsed.suggestedAction\n  }\n};"
      },
