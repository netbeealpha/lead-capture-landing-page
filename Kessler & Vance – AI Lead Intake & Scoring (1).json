    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-20b\",\n  \"response_format\": {\"type\": \"json_object\"},\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a lead-qualification assistant for a home renovation company called Kessler & Vance. Given a quote request, respond with ONLY a JSON object with three keys: score (one of: hot, warm, cold), summary (one sentence describing the lead ), and suggestedAction (one sentence on what the sales team should do next). Score hot for larger budgets or urgent language, cold for vague requests or very small budgets, warm otherwise.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Name: {{ $json.fullName }}\\nProject type: {{ $json.projectType }}\\nBudget: {{ $json.budget }}\\nDetails: {{ $json.details }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "358c151b-8d4a-43b6-9ff0-08048046b9d5",
